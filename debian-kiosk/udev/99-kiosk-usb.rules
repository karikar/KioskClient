# Debian kiosk - USB tároló automatikus importja
# Csak USB-s, partíció szintű, ismert fájlrendszerű eszközök.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_BUS}=="usb", ENV{ID_FS_TYPE}=="vfat|exfat|ntfs|ntfs3|ext4|ext3|iso9660", TAG+="systemd", ENV{SYSTEMD_WANTS}+="kiosk-usb-import@%k.service"
